# Use a separate database that you own. Never enter the original database URI here.
MONGODB_URI=mongodb://127.0.0.1:27017/workpulse_review
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
NODE_ENV=development
BIOMETRIC_ENCRYPTION_KEY=replace-with-your-own-random-value

# Optional: provide your own sender to try regular OTP and email workflows.
EMAIL_PROVIDER=gmail
SMTP_USER=
SMTP_APP_PASSWORD=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Workpulse Review
