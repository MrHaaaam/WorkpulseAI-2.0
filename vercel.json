{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://workpulse-backend-c8f1.onrender.com/api/:path*"
    },
    {
      "source": "/overview",
      "destination": "/index.html"
    },
    {
      "source": "/kiosk",
      "destination": "/index.html"
    }
  ]
}
